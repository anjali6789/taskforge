<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    
    <modelVersion>4.0.0</modelVersion>
    
    <parent>
        <groupId>com.taskforge</groupId>
        <artifactId>taskforge-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    
    <artifactId>taskforge-notification</artifactId>
    <name>TaskForge Notification</name>
    <description>Notification services - Kafka, RabbitMQ, Email</description>
    
    <!-- ==================== DEPENDENCIES ==================== -->
    <!-- 
        This module handles ALL async communication:
        - Kafka event publishing/consuming
        - RabbitMQ message queues
        - Email sending
        - Push notifications (future)
        
        It can run as a separate microservice or be included in the main app.
    -->
    <dependencies>
        <!-- ===== Internal Dependencies ===== -->
        <dependency>
            <groupId>com.taskforge</groupId>
            <artifactId>taskforge-common</artifactId>
        </dependency>
        
        <!-- ===== Messaging - Kafka ===== -->
        <!-- 
            Spring Kafka for:
            - Publishing events (task created, status changed, etc.)
            - Consuming events
            - Kafka Streams for real-time processing
        -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>
        
        <!-- ===== Messaging - RabbitMQ ===== -->
        <!-- 
            Spring AMQP for:
            - Work queues (email sending, file processing)
            - Pub/Sub patterns
            - RPC-style communication
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        
        <!-- ===== Email ===== -->
        <!-- 
            Spring Mail for:
            - SMTP email sending
            - HTML emails with Thymeleaf templates
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        
        <!-- 
            Thymeleaf for HTML email templates
            Allows dynamic content in emails (user names, task details, etc.)
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        
        <!-- ===== Testing ===== -->
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.amqp</groupId>
            <artifactId>spring-rabbit-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>kafka</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
    
</project>
